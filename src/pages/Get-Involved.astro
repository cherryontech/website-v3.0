---
import Layout from '../layouts/Layout.astro';
import blueMeeting from '../assets/get_involved/blue_meeting.svg';
---

<Layout title="Cherry On Tech | Get Involved">
	<section class="hero section-pink">
        <div class="hero__container">
            <div class="hero__copy">
                <h1 id="get-involved-title">Your Role in <br class="hero__title-break" /><span>Tech Equity</span> Starts Here</h1>
                <p>Claim your space in tech by showing up with intention.</p>
                <a href="#help-us-grow" class="btn btn-stroke btn-small">Help Us Grow</a>
                <a href="#grow-and-fuel-the-mission" class="btn btn-secondary btn-small">Fuel the Mission</a>
            </div>
        <div class="hero__image">
        <img src={blueMeeting.src} alt="2 people discussing an idea" />
            </div>
        </div>
    </section>

    <section id="help-us-grow">

    </section>

    <section id="grow-and-fuel-the-mission">

    </section>
</Layout>
