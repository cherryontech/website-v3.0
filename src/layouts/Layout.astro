---
import '../styles/global.css'
import Header from '../components/header/Header.tsx'
import Footer from '../components/footer/Footer'
import logo from '../assets/cherry_on_tech.svg'

interface Props {
    title?: string
    headerVariant?: 'default' | 'policy'
}

const { title = 'Cherry On Tech', headerVariant = 'default' } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        {
            headerVariant === 'policy' ? (
                <header class="policy-header">
                    <a href="/" aria-label="Cherry On Tech home">
                        <img src={logo.src} alt="Cherry On Tech" />
                    </a>
                </header>
            ) : (
                <Header client:load />
            )
        }
        <main>
            <slot />
        </main>
        <Footer currentPath={Astro.url.pathname} />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }
</style>
