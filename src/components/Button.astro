---
type ButtonVariant = 'primary' | 'secondary' | 'stroke' | 'link';
type ButtonSize = 'large' | 'small';
type ButtonState = 'default' | 'hover' | 'active' | 'disabled';
type ButtonKind = 'button' | 'submit' | 'reset';
type ButtonType = 'default' | 'icon-only';
interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  state?: ButtonState;
  ariaLabel?: string;
  buttonType?: ButtonType;
  href?: string;
  type?: ButtonKind;
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'large',
  state = 'default',
  ariaLabel,
  buttonType = 'default',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
} = Astro.props;

const isDisabled = disabled || state === 'disabled';
const isLink = variant === 'link' || Boolean(href);
const isIconOnly = buttonType === 'icon-only';
const buttonClass = [
  variant === 'link' ? (size === 'small' ? 'link-small' : 'link') : 'btn',
  variant !== 'link' ? `btn-${variant}` : '',
  variant !== 'link' && size === 'small' ? 'btn-small' : '',
  isIconOnly ? 'btn-icon-only' : '',
  state === 'hover' ? 'is-hover' : '',
  state === 'active' ? 'is-active' : '',
  isDisabled ? 'is-disabled' : '',
  className,
].filter(Boolean).join(' ');
---

{isLink ? (
  <a
    class={buttonClass}
    href={isDisabled ? undefined : href ?? '#'}
    aria-disabled={isDisabled ? 'true' : undefined}
    aria-label={isIconOnly ? ariaLabel : undefined}
  >
    <slot />
  </a>
) : (
  <button
    class={buttonClass}
    type={type}
    disabled={isDisabled}
    aria-label={isIconOnly ? ariaLabel : undefined}
  >
    <slot />
  </button>
)}
